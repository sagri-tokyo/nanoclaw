SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- Slack file-attachment ingestion (sagri-tokyo/sagri-ai#264) ---
# Opt-in. When true, the agent ingests whitelisted text/tabular attachments
# (CSV/TSV/JSON/plain/markdown), sanitizes them host-side, and surfaces them as
# laundered run context. PREREQUISITE: add the `files:read` OAuth scope to the
# Slack app and reinstall — without it, downloads return HTTP 401 and files are
# skipped. Default false = attachments ignored (unchanged behaviour).
SLACK_FILE_INGESTION=false
# Per-file download byte cap (streamed; socket destroyed on exceed). Default 256 KiB.
SLACK_FILE_MAX_BYTES=262144
# Max files ingested per actor run. Default 10.
SLACK_FILE_MAX_COUNT=10
# Max rows emitted per delimited (CSV/TSV) file. Default 1000.
SLACK_FILE_MAX_ROWS=1000
# Total character budget for the appended <untrusted_files> section. Default 120000.
SLACK_FILE_MAX_PROMPT_CHARS=120000
